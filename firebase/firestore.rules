rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() {
      return request.auth != null
        && request.auth.token.email == 'aramesbrasil40@gmail.com'
        && request.auth.token.email_verified == true;
    }
    match /vehicles/{vehicleId} {
      allow get: if owner() && vehicleId == 'vehicle-1';
      allow list: if false;
      allow create, update: if owner() && vehicleId == 'vehicle-1'
        && request.resource.data.keys().hasAll(['latitude','longitude','accuracyMeters','speedMetersPerSecond','capturedAtClientMs','updatedAt','deviceStatus'])
        && request.resource.data.keys().hasOnly(['latitude','longitude','accuracyMeters','speedMetersPerSecond','capturedAtClientMs','updatedAt','deviceStatus'])
        && request.resource.data.latitude is number && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180
        && request.resource.data.accuracyMeters is number
        && request.resource.data.speedMetersPerSecond is number
        && request.resource.data.capturedAtClientMs is int
        && request.resource.data.updatedAt == request.time
        && request.resource.data.deviceStatus == 'tracking';
      allow delete: if false;
    }
  }
}
